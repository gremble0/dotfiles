[pull]
  rebase = false
[push]
  autoSetupRemote = true
[init]
  defaultBranch = main
[branch]
  autoSetupMerge = false
[core]
  editor = nvim
[color]
  pager = yes
[alias]
  st = status
  # Commit
  cm = commit
  ca = commit --amend
  lg = log --name-status
  cp = cherry-pick
  ad = add
  # Remote
  rv = remote -v
  fe = fetch
  pu = push
  pl = pull
  cl = clone
  # Diffs
  df = diff
  dc = diff --cached
  # Branches
  co = checkout
  br = branch
  sw = switch
  rb = rebase
  mg = merge
  # Stash
  sp = stash pop
  ss = stash
  # Worktree
  wl = worktree list
