#!/bin/sh

# Define the options
options="Shutdown\nReboot Linux\nReboot Windows"

# Show the options in Wofi and capture the selection
selection=$(echo -e "$options" | wofi --dmenu --prompt "Choose an option")

# Execute based on selection
case "$selection" in
    "Shutdown")
        shutdown now
        ;;
    "Reboot Linux")
        boot-linux
        ;;
    "Reboot Windows")
        boot-windows
        ;;
esac
